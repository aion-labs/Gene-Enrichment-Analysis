graph enrichment_network {
  // 75 validated input genes; network = terms passing the term-level filter
  graph [input_genes=75, random_lists=10000, q_threshold="0.1", network_p="<0.0001"];
  // communities: Leiden (igraph, modularity), modularity="0.3043"
  graph [community_method="Leiden (igraph, modularity)", modularity="0.3043"];
  subgraph cluster_C1 {
    label="C1"; lead_term="HALLMARK: HYPOXIA"; terms=11; genes=41;
    "term_HALLMARK_HYPOXIA" [type=term, label="HALLMARK: HYPOXIA", collection="H: Hallmark Gene Sets", iteration=1, p="2.9e-21", q="0", community=C1, genes=25];
    "term_REACTOME_TP53_REGULATES_METABOLIC_GENES" [type=term, label="REACTOME: TP53 REGULATES METABOLIC GENES", collection="C2: Reactome Pathways", iteration=4, p="0.0055", q="0.017", community=C1, genes=3];
    "term_WP_ADIPOGENESIS" [type=term, label="WP: ADIPOGENESIS", collection="C2: WikiPathways", iteration=3, p="0.00037", q="0.004", community=C1, genes=5];
    "term_WP_HEMATOPOIETIC_STEM_CELL_DIFFERENTIATION" [type=term, label="WP: HEMATOPOIETIC STEM CELL DIFFERENTIATION", collection="C2: WikiPathways", iteration=4, p="0.0023", q="0.008", community=C1, genes=3];
