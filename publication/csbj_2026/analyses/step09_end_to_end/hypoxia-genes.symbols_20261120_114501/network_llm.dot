  "P4HA2" [type=gene, degree=5, community=C4, bridge=true, participation="0.32"];
  "PGK1" [type=gene, degree=9, community=C3, bridge=true, participation="0.49"];
  "PIM1" [type=gene, degree=5, community=C1, bridge=true, participation="0.48"];
  "SLC16A1" [type=gene, degree=2, community=C3, bridge=true, participation="0.5"];
