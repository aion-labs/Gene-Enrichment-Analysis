    "term_GOMF_2_OXOGLUTARATE_DEPENDENT_DIOXYGENASE_ACTIVITY" [type=term, label="GOMF: 2 OXOGLUTARATE DEPENDENT DIOXYGENASE ACTIVITY", collection="C5: Gene Ontology: Molecular Function", iteration=1, p="8.7e-12", q="0", community=C4, genes=9];
