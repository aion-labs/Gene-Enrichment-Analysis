    "term_GOBP_RESPONSE_TO_STARVATION" [type=term, label="GOBP: RESPONSE TO STARVATION", collection="C5: Gene Ontology: Biological Process", iteration=5, p="0.0022", q="0.043", community=C1, genes=4];
    "term_GOBP_SYMBIONT_ENTRY_INTO_HOST" [type=term, label="GOBP: SYMBIONT ENTRY INTO HOST", collection="C5: Gene Ontology: Biological Process", iteration=6, p="0.0036", q="0.045", community=C1, genes=3];
    "term_GOBP_POSITIVE_REGULATION_OF_MAPK_CASCADE" [type=term, label="GOBP: POSITIVE REGULATION OF MAPK CASCADE", collection="C5: Gene Ontology: Biological Process", iteration=7, p="0.0026", q="0.043", community=C1, genes=5];
    "term_GOBP_GENERATION_OF_PRECURSOR_METABOLITES_AND_ENERGY" [type=term, label="GOBP: GENERATION OF PRECURSOR METABOLITES AND ENERGY", collection="C5: Gene Ontology: Biological Process", iteration=8, p="0.0083", q="0.059", community=C1, genes=4];
    "term_GOCC_TRANSCRIPTION_REGULATOR_COMPLEX" [type=term, label="GOCC: TRANSCRIPTION REGULATOR COMPLEX", collection="C5: Gene Ontology: Cellular Component", iteration=4, p="0.007", q="0.025", community=C1, genes=6];
    "term_GOMF_STEROID_BINDING" [type=term, label="GOMF: STEROID BINDING", collection="C5: Gene Ontology: Molecular Function", iteration=3, p="0.0071", q="0.04", community=C1, genes=3];
    "ASCC1" [type=gene, degree=1, community=C1];
    "ATF3" [type=gene, degree=3, community=C1];
    "ATF7IP" [type=gene, degree=1, community=C1];
    "CRKL" [type=gene, degree=1, community=C1];
    "EFNA1" [type=gene, degree=2, community=C1];
    "GYS1" [type=gene, degree=2, community=C1];
    "ILF3" [type=gene, degree=1, community=C1];
    "INSIG2" [type=gene, degree=1, community=C1];
    "KLF10" [type=gene, degree=1, community=C1];
    "MXI1" [type=gene, degree=3, community=C1];
    "NAMPT" [type=gene, degree=2, community=C1];
    "PJA2" [type=gene, degree=1, community=C1];
    "RARA" [type=gene, degree=3, community=C1];
    "RBPJ" [type=gene, degree=3, community=C1];
    "RRAGD" [type=gene, degree=3, community=C1];
    "TMEM45A" [type=gene, degree=1, community=C1];
    "WSB1" [type=gene, degree=1, community=C1];
  }
  subgraph cluster_C2 {
    label="C2"; lead_term="GOBP: CELLULAR RESPONSE TO OXYGEN LEVELS"; terms=7; genes=26;
    "term_PID_MYC_ACTIV_PATHWAY" [type=term, label="PID: MYC ACTIV PATHWAY", collection="C2: Pathway Interaction Database", iteration=2, p="0.0042", q="0.0005", community=C2, genes=4];
