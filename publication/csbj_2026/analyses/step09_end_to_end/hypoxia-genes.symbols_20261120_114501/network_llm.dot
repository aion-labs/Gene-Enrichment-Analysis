    "term_KEGG_GLYCOLYSIS_GLUCONEOGENESIS" [type=term, label="KEGG: GLYCOLYSIS GLUCONEOGENESIS", collection="C2: KEGG Legacy", iteration=1, p="2.7e-05", q="0", community=C3, genes=5];
