    "term_GOCC_FICOLIN_1_RICH_GRANULE_LUMEN" [type=term, label="GOCC: FICOLIN 1 RICH GRANULE LUMEN", collection="C5: Gene Ontology: Cellular Component", iteration=5, p="0.005", q="0.025", community=C3, genes=3];
    "term_GOCC_NUCLEAR_ENVELOPE" [type=term, label="GOCC: NUCLEAR ENVELOPE", collection="C5: Gene Ontology: Cellular Component", iteration=6, p="0.0093", q="0.025", community=C3, genes=5];
    "NARF" [type=gene, degree=1, community=C3];
    "NXF1" [type=gene, degree=1, community=C3];
    "PGAM1" [type=gene, degree=5, community=C3];
    "SPAG4" [type=gene, degree=1, community=C3];
  }
  subgraph cluster_C4 {
    label="C4"; lead_term="GOMF: 2 OXOGLUTARATE DEPENDENT DIOXYGENASE ACTIVITY"; terms=6; genes=15;
    "term_REACTOME_COLLAGEN_FORMATION" [type=term, label="REACTOME: COLLAGEN FORMATION", collection="C2: Reactome Pathways", iteration=2, p="0.0011", q="0.017", community=C4, genes=4];
    "term_REACTOME_HDMS_DEMETHYLATE_HISTONES" [type=term, label="REACTOME: HDMS DEMETHYLATE HISTONES", collection="C2: Reactome Pathways", iteration=3, p="0.0017", q="0.017", community=C4, genes=3];
