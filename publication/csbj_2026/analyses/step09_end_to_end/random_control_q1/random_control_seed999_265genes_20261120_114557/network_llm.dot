    "term_GOBP_NEGATIVE_REGULATION_OF_MUSCLE_HYPERTROPHY" [type=term, label="GOBP: NEGATIVE REGULATION OF MUSCLE HYPERTROPHY", collection="C5: Gene Ontology: Biological Process", iteration=7, p="0.0077", q="0.65", community=C8, genes=3];
    "MIR25" [type=gene, degree=1, community=C8];
    "RGS2" [type=gene, degree=1, community=C8];
    "STUB1" [type=gene, degree=1, community=C8];
