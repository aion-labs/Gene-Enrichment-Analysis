  // bridge genes: connect terms in different communities
  "CR2" [type=gene, degree=2, community=C1, bridge=true, participation="0.5"];
  // edges: each term with its genes
  "term_REACTOME_ASSEMBLY_OF_THE_ORC_COMPLEX_AT_THE_ORIGIN_OF_REPLICATION" -- {"H2AC14" "H2BC14" "H3C8" "ORC1"};
