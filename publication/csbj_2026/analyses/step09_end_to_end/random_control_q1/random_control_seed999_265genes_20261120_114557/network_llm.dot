graph enrichment_network {
  // 264 validated input genes; network = terms passing the term-level filter
  graph [input_genes=264, random_lists=10000, q_threshold="none", network_p="0.635"];
  // communities: Leiden (igraph, modularity), modularity="0.4835"
  graph [community_method="Leiden (igraph, modularity)", modularity="0.4835"];
  subgraph cluster_C1 {
    label="C1"; lead_term="GOBP: RESPONSE TO CORTICOSTEROID"; terms=4; genes=15;
    "term_REACTOME_ASSEMBLY_OF_THE_ORC_COMPLEX_AT_THE_ORIGIN_OF_REPLICATION" [type=term, label="REACTOME: ASSEMBLY OF THE ORC COMPLEX AT THE ORIGIN OF REPLICATION", collection="C2: Reactome Pathways", iteration=1, p="0.0096", q="1", community=C1, genes=4];
    "term_KEGG_SYSTEMIC_LUPUS_ERYTHEMATOSUS" [type=term, label="KEGG: SYSTEMIC LUPUS ERYTHEMATOSUS", collection="C2: KEGG Legacy", iteration=1, p="0.0072", q="0.46", community=C1, genes=6];
