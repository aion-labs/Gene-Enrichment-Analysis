  subgraph cluster_C9 {
    label="C9"; lead_term="GOBP: REGULATION OF CLATHRIN DEPENDENT ENDOCYTOSIS"; terms=1; genes=3;
    "term_GOBP_REGULATION_OF_CLATHRIN_DEPENDENT_ENDOCYTOSIS" [type=term, label="GOBP: REGULATION OF CLATHRIN DEPENDENT ENDOCYTOSIS", collection="C5: Gene Ontology: Biological Process", iteration=3, p="0.0011", q="0.45", community=C9, genes=3];
    "CCDC32" [type=gene, degree=1, community=C9];
