    "gene_PARP3" [label="PARP3", type="gene", width=0.7, height=0.7];
    "term_1_GOBP_NEGATIVE_REGULATION_OF_B_CELL_MEDIATED_IMMUNITY" [label="GOBP: NEGATIVE REGULATION OF B CELL MEDIATED IMMUNITY", style=filled, fillcolor="#C50A00", fontcolor="white", type="term", collection="C5: Gene Ontology: Biological Process", width=2, height=2];
    "gene_C4BPB" -- "term_1_GOBP_NEGATIVE_REGULATION_OF_B_CELL_MEDIATED_IMMUNITY" [color="#C50A00"];
    "gene_CR2" -- "term_1_GOBP_NEGATIVE_REGULATION_OF_B_CELL_MEDIATED_IMMUNITY" [color="#C50A00"];
    "gene_FCGR2B" -- "term_1_GOBP_NEGATIVE_REGULATION_OF_B_CELL_MEDIATED_IMMUNITY" [color="#C50A00"];
