    "SLC22A12" [type=gene, degree=1, community=C1];
    "SLC28A3" [type=gene, degree=1, community=C1];
  }
  subgraph cluster_C2 {
    label="C2"; lead_term="GOBP: REGULATION OF LONG TERM SYNAPTIC POTENTIATION"; terms=2; genes=7;
