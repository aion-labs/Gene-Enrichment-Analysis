graph enrichment_network {
  // 263 validated input genes; network = terms passing the term-level filter
  graph [input_genes=263, random_lists=1000, q_threshold="none", network_p="0.679"];
  // communities: Leiden (igraph, modularity), modularity="0.2188"
  graph [community_method="Leiden (igraph, modularity)", modularity="0.2188"];
  subgraph cluster_C1 {
    label="C1"; lead_term="GOCC: CILIARY PLASM"; terms=3; genes=16;
    "term_GOBP_NEGATIVE_REGULATION_OF_CELL_PROJECTION_ORGANIZATION" [type=term, label="GOBP: NEGATIVE REGULATION OF CELL PROJECTION ORGANIZATION", collection="C5: Gene Ontology: Biological Process", iteration=6, p="0.0074", q="0.86", community=C1, genes=6];
    "term_GOCC_CILIARY_PLASM" [type=term, label="GOCC: CILIARY PLASM", collection="C5: Gene Ontology: Cellular Component", iteration=1, p="0.00083", q="0.21", community=C1, genes=8];
