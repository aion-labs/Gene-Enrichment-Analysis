    "APOE" [type=gene, degree=1, community=C2];
    "NRGN" [type=gene, degree=1, community=C2];
    "PDE9A" [type=gene, degree=1, community=C2];
    "PDLIM5" [type=gene, degree=1, community=C2];
  }
  subgraph cluster_C3 {
    label="C3"; lead_term="GOBP: NUCLEAR TRANSCRIBED MRNA CATABOLIC PROCESS"; terms=1; genes=5;
    "term_GOBP_NUCLEAR_TRANSCRIBED_MRNA_CATABOLIC_PROCESS" [type=term, label="GOBP: NUCLEAR TRANSCRIBED MRNA CATABOLIC PROCESS", collection="C5: Gene Ontology: Biological Process", iteration=5, p="0.0071", q="0.86", community=C3, genes=5];
