  // bridge genes: connect terms in different communities
  "TRPC5" [type=gene, degree=2, community=C1, bridge=true, participation="0.5"];
  // edges: each term with its genes
  "term_REACTOME_BETA_DEFENSINS" -- {"DEFB104A" "DEFB114" "DEFB126"};
  "term_GOBP_REGULATION_OF_LONG_TERM_SYNAPTIC_POTENTIATION" -- {"ADORA1" "ADORA2A" "APOE" "NRGN" "PDE9A"};
  "term_GOBP_PROSTAGLANDIN_SECRETION" -- {"ABCC4" "ACSL4" "TNFRSF11A"};
  "term_GOBP_EXPLORATION_BEHAVIOR" -- {"CRBN" "DLG4" "GABRB3"};
  "term_GOBP_POSITIVE_REGULATION_OF_RESPONSE_TO_ENDOPLASMIC_RETICULUM_STRESS" -- {"RNFT2" "TMEM33" "UBQLN1"};
  "term_GOBP_NUCLEAR_TRANSCRIBED_MRNA_CATABOLIC_PROCESS" -- {"CNOT7" "DCP1B" "HNRNPAB" "LSM7" "SYNCRIP"};
  "term_GOBP_NEGATIVE_REGULATION_OF_CELL_PROJECTION_ORGANIZATION" -- {"DGUOK" "DPYSL3" "EFNB3" "LIMA1" "MAK" "TRPC5"};
  "term_GOCC_CILIARY_PLASM" -- {"CFAP52" "CFAP90" "DNAH11" "EFHC2" "GLI1" "MAK" "RPGRIP1" "SEPTIN2"};
  "term_GOCC_BRUSH_BORDER_MEMBRANE" -- {"CLTRN" "LIMA1" "SLC22A12" "SLC28A3"};
  "term_GOMF_ASPARTIC_TYPE_PEPTIDASE_ACTIVITY" -- {"CTSD" "DDI2" "PGC"};
  "term_GOMF_ACTININ_BINDING" -- {"ADORA2A" "PDLIM5" "TRPC5"};
}