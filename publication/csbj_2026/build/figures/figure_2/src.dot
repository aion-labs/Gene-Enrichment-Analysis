graph Fig2_iGEA_GO_network {
  graph [layout=neato, overlap=false, splines=false, outputorder=edgesfirst, bgcolor="white", pad=0.3, sep="+6"];
  node [fontname="Helvetica-Bold"];
  edge [penwidth=0.8];
  "t_GOBP_GOLGI_VESICLE_TRANSPORT" [label="GOBP: GOLGI VESICLE\nTRANSPORT", shape=box, style="rounded,filled", fillcolor="#F1948A", fontcolor="#1F1F1F", color="#1F1F1F", penwidth=1.2, fontsize=14, margin="0.12,0.06"];
  "t_GOBP_NUCLEAR_EXPORT" [label="GOBP: NUCLEAR EXPORT", shape=box, style="rounded,filled", fillcolor="#F1948A", fontcolor="#1F1F1F", color="#1F1F1F", penwidth=1.2, fontsize=14, margin="0.12,0.06"];
